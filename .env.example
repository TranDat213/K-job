# ================================
# Database (PostgreSQL)
# ================================
POSTGRES_USER=koc_user
POSTGRES_PASSWORD=koc_password
POSTGRES_DB=koc_manager
POSTGRES_PORT=5334

DATABASE_URL="postgresql://koc_user:koc_password@localhost:5334/koc_manager?schema=public"

# ================================
# NestJS API
# ================================
API_PORT=3002
NODE_ENV=development

# JWT Secret — generate a strong random string in production
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS origin (Next.js dev server)
CORS_ORIGIN=http://localhost:3000

# ================================
# Next.js Frontend
# ================================
NEXT_PUBLIC_API_URL=http://localhost:3002

# ================================
# Future — TikTok OAuth (not used yet)
# ================================
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=

# ================================
# Future — Redis / BullMQ (not used yet)
# ================================
# REDIS_HOST=localhost
# REDIS_PORT=6379

# ================================
# Future — Storage (MinIO/S3) (not used yet)
# ================================
# STORAGE_ENDPOINT=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_BUCKET=
